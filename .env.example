# WikiCollab — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# PostgreSQL
POSTGRES_USER=wikicollab
POSTGRES_PASSWORD=wikicollab
POSTGRES_DB=wikicollab

# Backend
PORT=8080
DATABASE_URL=postgres://wikicollab:wikicollab@localhost:5432/wikicollab?sslmode=disable
SESSION_SECRET=change-me-in-production

# CORS — React dev server origin
CORS_ORIGIN=http://localhost:5173

# Redis (used by Member 2 for collaboration locks)
REDIS_URL=redis://localhost:6379
LOCK_TTL=30s
LOCK_RENEW_INTERVAL=10s

# Test database (used by backend tests)
TEST_DATABASE_URL=postgres://wikicollab:wikicollab@localhost:5432/wikicollab_test?sslmode=disable
